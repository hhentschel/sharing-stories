header {
  position: relative;
}

.header__bg {
  position: relative;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: auto;
    max-height: 300px;
    /* height: auto; */
}

.header__bg-image {
  max-height: 250px;
  margin: 0 auto;
}

.header__bg-picture {
  object-fit: cover;
  width: 100%;
  height: 100%;
}