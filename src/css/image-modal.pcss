/* Image Modal using HTML dialog element with Tailwind classes */

/* Animation when opening/closing */
dialog[open] {
  animation: modal-fade-in 0.2s ease-out;
}

dialog[open] img {
  animation: modal-scale-in 0.3s ease-out;
}

@keyframes modal-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes modal-scale-in {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

/* Make images with modal clickable */
img[data-modal] {
  @apply cursor-pointer transition-opacity duration-200 hover:opacity-80;
}

/* Mobile responsive adjustments */
@media (max-width: 768px) {
  dialog img {
    @apply max-w-[90vw] max-h-[75vh];
  }
  
  dialog button {
    @apply w-10 h-10;
    top: -0.25rem; /* -top-1 equivalent */
    right: -3rem; /* -right-12 equivalent */
  }
  
  dialog button svg {
    @apply w-5 h-5;
  }
}