  {%- import '_macros/atomic' as atoms -%}

{%- set props = collect({
    color: color ??? 'text-black',
    utilities: utilities ??? '',
    position: position ??? {y: 'bottom', x: 'left'},
    entryType: entryType ??? null,
}) -%}

{%- minify -%}
    {%- set currentElement = craft.app.urlManager.matchedElement -%}
    {%- set sites = craft.app.sites.getAllSites() -%}
    {%- set switcherLinks = collect([]) -%}

    {%- for site in sites -%}
        {%- if site.baseUrl is not empty -%}
            {%- set title = site.name -%}
            {%- set url = site.baseUrl -%}

            {%- if entry is defined -%}
                {%- set siteEntry = craft.entries.id(entry.id).siteId(site.id).one() -%}
                {%- if siteEntry -%}
                    {%- set url = siteEntry.url -%}
                {%- endif -%}
            {%- endif -%}

            {%- set customLabels = {
                'ka': 'ab',
                'de': 'de',
                'ru': 'ru',
            } -%}
            
            {%- set languageCode = site.language|slice(0,2)|lower -%}
            {%- set displayLabel = customLabels[languageCode] ??? languageCode -%}
            
            {%- set switcherLinks = switcherLinks.push({
                url: url,
                title: title,
                countryCode: site.language|split('-')|last,
                current: site.id == currentSite.id ? true : false,
                language: site.language,
                displayLabel: displayLabel,
            }) -%}
        {%- endif -%}
    {%- endfor -%}

    {%- if switcherLinks.count > 0 -%}
        <nav class="language-switcher">
            <ul class="language-switcher__list flex space-x-1">
                {% for switcherLink in switcherLinks %}
                    <li class="language-switcher__item">
                        {# <a href="{{ switcherLink.url }}"
                           class="language-switcher__link text-xs {{ props.get('color') }} {{ switcherLink.current ? 'font-semibold underline' : 'hover:underline' }}"
                           {% if switcherLink.current %}aria-current="true"{% endif %}
                           hreflang="{{ switcherLink.language }}">
                            {{ switcherLink.language|slice(0,2)|lower }}
                        </a> #}
                        <li>
                            {{- atoms.atom('link', 'navigation-footer', {
                                url: switcherLink.url ~ (craft.app.request.getQueryStringWithoutPath() | length > 0 ? '?' ~ craft.app.request.getQueryStringWithoutPath() : ''),
                                text: switcherLink.displayLabel,
                                utilities: 'px-4 block w-full' ~ (switcherLink.current ? ' underline font-semibold' : ''),

                            }) -}}
                        </li>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {%- endif -%}
{%- endminify -%}