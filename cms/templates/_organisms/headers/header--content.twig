{%- extends '_organisms/headers/_header--props' -%}
{%- import '_macros/organic' as organisms -%}
{%- import '_macros/atomic' as atoms -%}

{%- block header -%}
    {%- set classes = collect({
        color: props.get('color') ??? 'text-black',
        font: 'font-primary',
        size: 'text-h1-sm md:text-h1-md lg:text-h1-lg',
        utilities: props.get('utilities'),
        padding: props.get('padding') ??? 'py-3 px-2 lg:py-1',
    }) -%}

    {%- minify -%}
        <header class="{{ classes.implode(' ') }}">
                <div class="header__content container relative z-10 flex justify-between">
                    {# <div>
                        {{- props.get('content')|striptags('<strong><a>')|typogrify()|raw -}}
                    </div> #}
                </div>
                <div class="header__bg">
                 <a href="/">{{- atoms.atom('image', 'hero',  {
                    image: header.imageHero.eagerly().collect.first,
                    sizes: '100vw',
                    placeholder: 'image',
                    loadingStrategy: 'eager',
                    utilitiesImage: 'w-auto h-full p-3 header__bg-image',
                    utilitiesPicture: 'header__bg-picture'
                }) -}}</a>
                </div>
        </header>
    {%- endminify -%}
{%- endblock -%}