{%- import '_macros/atomic' as atoms -%}

<div class="grid sm:grid-cols-3 grid-cols-1 gap-4 mb-12 block">
{# {{- atoms.atom('image', 'content',  {
    image: entry.imageContent.one(),
    sizes: '50vw',
    placeholder: 'image',
    loadingStrategy: 'lazy'
}) -}} #}


 {% for image in entry.imageContent %}
{{- atoms.atom('image', 'content',  {
    image: image,
    sizes: '35vw',
    placeholder: 'image',
    caption: entry.caption,
    class: 'inline-flex',
    utilitiesPicture: 'block mb-4',
    loadingStrategy: 'lazy',
          attributes: {
          'data-modal': true,
          'data-modal-src': image.getUrl({width: 1920})
      }
}) -}}
{% endfor %}

</div>