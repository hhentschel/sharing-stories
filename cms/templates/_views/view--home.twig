{%- import '_macros/atomic' as atoms -%}

<div class="container">
{% if entry.title %}
<div class=" bg-slate-200 p-6 rounded mt-6 mb-12">
    {{ entry.title }}
</div>
{% endif %}


<div class="grid grid-cols-2 gap-4 mt-16 mb-16">
     <div class="text-[18px]">
         {# {{- atoms.atom('image', 'hero',  {
                image: entry.imageHero.eagerly().collect.first,
                sizes: '30vw',
                placeholder: 'silhouette',
                loadingStrategy: 'eager',
            }) -}} #}
         {{ entry.HomeContent }}
    </div>

    <div class="text-[18px]">
         {# {{- atoms.atom('text', 'content', {
        {# {{ entry.longformContent }} #}
         {{ entry.HomeContent2 }}
    </div>
</div>

<div class="homepage-grid columns-2 gap-4 rounded mt-6 mb-12">

    {# Create an entry query with the 'section' and 'limit' parameters #}
{% set myEntryQuery = craft.entries()
  .section('pages')
  .limit(10) %}

{# Fetch the entries #}
{% set entries = myEntryQuery.all() %}

{# Display the entries #}
{% for entry in entries %}
  <article>
    <h1><a href="{{ entry.url }}">{{ entry.title }}
    {% if entry.imageTeaser.one() %}

 {{- atoms.atom('image', 'teaser',  {
            image: entry.imageTeaser.eagerly().collect.first,
            sizes: '30vw',
            placeholder: 'silhouette',
            loadingStrategy: 'eager',
        }) -}}
    {% endif %}
    </a></h1>
  </article>
{% endfor %}
</div>



    <div class="">

        {# view--home #}

            {% for block in entry.contentBuilder.all() %}
            {% switch block.type %}

                {% case "cta" %}
                {{ block.render() }}

                {% case "richText" %}
                <div class="inline-block">
                {{ block.render() }}
                </div>

                {% case "iframe" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "iframeSound" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "images" %}
                <div class="columns-2 lg:columns-3 gap-4">
                {{ block.render() }}
                </div>

                 {% case "gif" %}
                <div class="gif">
                {{ block.render() }}
                </div>

                {% case "featureList" %}
                {{ block.render({ loop, themeColor: "lightblue" }) }}

                {% case "relatedEntries" %}
                {{ block.render() }}

                {% case "table" %}
                {{ block.render() }}

                {% default %}




            {% endswitch %}

            {% endfor %}

    </div>
</div>


