{%- import '_macros/atomic' as atoms -%}

<div class="container bg-amber-100 flex flex-wrap gap-4 rounded mt-6 mb-12">


    <div class="w-6/12 text-lg">
         {{- atoms.atom('image', 'hero',  {
                image: entry.imageHero.eagerly().collect.first,
                sizes: '40vw',
                placeholder: 'silhouette',
                loadingStrategy: 'eager',
            }) -}}
    </div>

    <div class="flex flex-wrap text-[18px] pt-4">
        {{ entry.longformContent }}
    </div>
</div>

<div class="container ">

    {{ entry.title }}

    <div class="">
        {{ entry.HomeContent }}
        {# view--home #}

            {% for block in entry.contentBuilder.all() %}
            {% switch block.type %}

                {% case "cta" %}
                {{ block.render() }}

                {% case "richText" %}
                {{ block.render() }}

                {% case "images" %}
                {{ block.render() }}

                {% case "featureList" %}
                {{ block.render({ loop, themeColor: "lightblue" }) }}

                {% case "relatedEntries" %}
                {{ block.render() }}

                {% case "table" %}
                {{ block.render() }}

                {% default %}


            {% endswitch %}

            {% endfor %}

    </div>
</div>


