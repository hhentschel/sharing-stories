{%- import '_macros/atomic' as atoms -%}

<div class="container pt-12">
{% if entry.title %}
<div class=" bg-slate-200 p-6 rounded mt-6 mb-12">
    {{ entry.title }}
</div>
{% endif %}

{% if entry.HomeContent %}
<div class="grid grid-cols-2 gap-4 mt-16 mb-16">
     <div class="text-[18px]">
         {# {{- atoms.atom('image', 'hero',  {
                image: entry.imageHero.eagerly().collect.first,
                sizes: '30vw',
                placeholder: 'silhouette',
                loadingStrategy: 'eager',
            }) -}} #}
         {{ entry.HomeContent }}
    </div>

    <div class="text-[18px]">
         {# {{- atoms.atom('text', 'content', {
        {# {{ entry.longformContent }} #}
         {{ entry.HomeContent2 }}
    </div>
</div>
{% endif %}

{# <div class="homepage-grid gap-4 rounded mt-6 mb-12"> #}
{# <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4"> #}
<div class="grid grid-cols-[repeat(auto-fit,minmax(400px,1fr))] gap-14">

    {# Create an entry query with the 'section' and 'limit' parameters #}
{% set myEntryQuery = craft.entries()
  .section('pages')
  .limit(10) %}

{# Fetch the entries #}
{% set entries = myEntryQuery.all() %}

{# Display the entries #}
{% for entry in entries %}
  <article>
    <a href="{{ entry.url }}" title="{{ entry.title }}">
    {# {% if entry.imageTeaser.one() %}
        {{- atoms.atom('image', 'teaser',  {
            image: entry.imageTeaser.eagerly().collect.first,
            sizes: '40vw',
            placeholder: 'silhouette',
            loadingStrategy: 'eager',
            utilitiesImage: 'object-cover',
            utilitiesPicture: '',
        }) -}}
    {% endif %} #}

    {% if entry.imageHero.one() %}
        {{- atoms.atom('image', 'hero',  {
            image: entry.imageHero.eagerly().collect.first,
            sizes: '30vw',
            placeholder: 'image',
            loadingStrategy: 'eager',
            utilitiesImage: 'block max-h-[300px] w-auto object-contain',
            utilitiesPicture: 'max-h-[300px] flex items-center justify-center',
        }) -}}
    {% endif %}
    </a>
  </article>
{% endfor %}
</div>



    <div class="">

        {# view--home #}

            {% for block in entry.contentBuilder.all() %}
            {% switch block.type %}

                {% case "cta" %}
                {{ block.render() }}

                {% case "richText" %}
                <div class="inline-block">
                {{ block.render() }}
                </div>

                {% case "iframe" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "iframeSound" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "images" %}
                <div class="columns-2 lg:columns-3 gap-4">
                {{ block.render() }}
                </div>

                 {% case "gif" %}
                <div class="gif">
                {{ block.render() }}
                </div>

                {% case "featureList" %}
                {{ block.render({ loop, themeColor: "lightblue" }) }}

                {% case "relatedEntries" %}
                {{ block.render() }}

                {% case "table" %}
                {{ block.render() }}

                {% default %}




            {% endswitch %}

            {% endfor %}

    </div>
</div>


