{%- import '_macros/atomic' as atoms -%}

{%- set spotlight = entry.title -%}


{# view-page-landing #}
<div class="container mx-auto my-0 flex flex-col px-0 mt-12">
<a href="/">
    <img src="/content-files/images/content/arrow.png" alt="Pfeil nach links" class="inline w-[120px] mb-0"/>
</a>

        {# <h1 class="mb-6 mt-6">
            {{- atoms.atom('text', 'h2' , {
                    alignment: '',
                    content:  spotlight,
                    utilities: '',
                }) -}}
        </h1> #}

        {{- atoms.atom('image', 'teaser',  {
            image: entry.imageTeaser.eagerly().collect.first,
            sizes: '20vw',
            placeholder: 'silhouette',
            loadingStrategy: 'eager',
             utilitiesImage: 'block max-h-[150px] w-auto object-contain',
            utilitiesPicture: 'max-h-[150px] flex mb-12',
        }) -}}

         {# {{ entry.contentBuilder }} #}
        {% for block in entry.contentBuilder.all() %}
            {% switch block.type %}

                {% case "cta" %}
                {{ block.render() }}

                {% case "richText" %}
                {{ block.render() }}

                {% case "iframe" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "pdf" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "iframeSound" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "images" %}
                {# <div class="columns-2 lg:columns-3 gap-4 mb-12 block"> #}
                <div class="">
                {{ block.render() }}
                </div>

                 {% case "gif" %}
                <div class="grid grid-cols-2 mb-12">
                {{ block.render() }}
                </div>

                {% case "featureList" %}
                {{ block.render({ loop, themeColor: "lightblue" }) }}

                {% case "relatedEntries" %}
                {{ block.render() }}

                {% case "table" %}
                {{ block.render() }}

                {% default %}


            {% endswitch %}

            {% endfor %}
</div>

