{%- import '_macros/atomic' as atoms -%}

{%- set spotlight = entry.title -%}


{# view-page-landing #}
<div class="container mx-auto my-0 flex flex-col px-0 mt-12">
<a href="/">
    <img src="https://sharing-stories.ddev.site/content-files/images/content/josh-hild-K4WXehq5Alc-unsplash_2025-09-11-122653_wbev.jpg" alt="Pfeil nach links" class="inline w-44 h-12 mb-12"/>
</a>

        <h1>
            {{- atoms.atom('text', 'h1' , {
                    alignment: '',
                    content:  spotlight,
                    utilities: 'mb-4',

                }) -}}
        </h1>

         {# {{ entry.contentBuilder }} #}
        {% for block in entry.contentBuilder.all() %}
            {% switch block.type %}

                {% case "cta" %}
                {{ block.render() }}

                {% case "richText" %}
                {{ block.render() }}

                {% case "iframe" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "pdf" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "iframeSound" %}
                <div class="block">
                {{ block.render() }}
                </div>

                {% case "images" %}
                <div class="columns-2 lg:columns-3 gap-4">
                {{ block.render() }}
                </div>

                 {% case "gif" %}
                <div class="gif">
                {{ block.render() }}
                </div>

                {% case "featureList" %}
                {{ block.render({ loop, themeColor: "lightblue" }) }}

                {% case "relatedEntries" %}
                {{ block.render() }}

                {% case "table" %}
                {{ block.render() }}

                {% default %}


            {% endswitch %}

            {% endfor %}
</div>

