{%- extends '_atoms/buttons/_button--props' -%}
{%- import '_macros/atomic' as atoms -%}
{%- import '_macros/functions' as parse -%}

{#
    ### PROPERTIES ###
    ------------------
    
    INHERITED FROM: `_atoms/buttons/button--props.twig`

    ### FUNCTIONS ###
    -----------------
    ga: parse google analytics attributes
#}

{%- block button -%}

    {%- set color = props.get('color') ??? 'text-viridian-500' -%}
    {%- set focusColor = color == 'text-viridian-500' ? 'text-viridian-700' : 'text-viridian-500' -%}
    
    {%- set classes = collect({
        default: 'inline-flex items-center rounded-full whitespace-nowrap gap-x-2',
        position:  props.get('iconPosition') == null ? 'flex-row-reverse' : (props.get('iconPosition') == 'after' ? 'flex-row' : 'flex-row-reverse'),
        animation: 'transition-colors duration-200 ease-in-out',
        color: color,
        focus: 'focus:ring-4 focus:ring-celestial-500 focus:outline-none focus:' ~ focusColor ~' group-focus:ring-4 group-focus:ring-celestial-500 group-focus:outline-none group-focus:' ~ focusColor,
        font: 'font-primary text-bold-md tracking-wider not-italic',
        text: props.get('size').text,
        hover: 'hover:' ~ focusColor ~' group-hover:' ~ focusColor,
        disabled: 'disabled:text-concrete-700',
        utilities: props.get('utilities'),
    }) -%}
    
    {%- set classesDiv = collect({
        default: 'inline-flex items-center rounded-full whitespace-nowrap gap-x-2',
        position:  props.get('iconPosition') == null ? 'flex-row-reverse' : (props.get('iconPosition') == 'after' ? 'flex-row' : 'flex-row-reverse'),
        animation: 'transition-colors duration-200 ease-in-out',
        color: color,
        font: 'font-primary text-bold-md tracking-wider not-italic',
        text: props.get('size').text,
        utilities: props.get('utilities'),
    }) -%}

    {%- minify -%}
        {%- if props.get('url') -%}
            <a
                {{ props.get('url') ? 'href=' ~ props.get('url') : '' }}
                {{ parse.ga(props.get('ga')) }}
                {{ props.get('target') ? 'target=' ~ props.get('target') : '' }}
                aria-label="{{- props.get('label') -}}"
                class="{{- classes.implode(' ') -}}"
            >
        {%- else -%}
            <div class="{{- classesDiv.implode(' ') -}}">
        {%- endif -%}

                <span class="">
                    {{- props.get('text') -}}
                </span>

                {%- if props.get('icon') -%}
                    {{- atoms.atom('icon', 'fa', {
                        type: props.get('icon').type,
                        icon: props.get('icon').icon,
                    }) -}}
                {%- endif -%}

                
        {%- if props.get('url') -%}
            </a>
        {%- else -%}
            </div>
        {%- endif -%}
    {%- endminify -%}

{%- endblock -%}