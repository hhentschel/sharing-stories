{%- extends '_atoms/links/_link--props' -%}
{%- import '_macros/atomic' as atoms -%}
{%- import '_macros/functions' as parse -%}

{#
    ### PROPERTIES ###
    ------------------
    
    INHERITED FROM: `_atoms/links/link--props.twig`

    EXTENDED
    --------
    icon: (ENUM) -- the icon for the link
    iconPosition: (ENUM) -- the position of the icon

    ### FUNCTIONS ###
    -----------------
    ga: parse google analytics attributes

#}

{%- block link -%}
    
    {%- set props = props.merge({
        icon: options.icon ??? null,
        iconPosition: options.iconPosition ??? 'after',
    })-%}

    {%- set classes = collect({
        default: 'inline-flex justify-center items-center',
        animation: 'transition-colors duration-200 ease-in-out',
        font: 'font-normal text-lg tracking-wide leading-7',
        hover: 'hover:text-viridian-700',
        active: 'active:text-viridian-700',
        disabled: props.get('url') ? props.get('color') : 'text-concrete-700',
        focus: 'focus:ring-2 focus:ring-celestial-500 focus:outline-none',
        cursor: props.get('url') ? 'cursor-pointer' : 'pointer-events-none',
        position: props.get('iconPosition') == 'after' ? 'flex-row' : 'flex-row-reverse',
        textDecoration: props.get('textDecoration'),
        utilities: props.get('utilities'),
    }) -%}

    <a
        {{ props.get('url') ? 'href=' ~ props.get('url') : '' }}
        {{ parse.ga(props.get('ga')) }}
        {{ props.get('target') ? 'target=' ~ props.get('target') : '' }}
        aria-label="{{- props.get('label') -}}"
        class="{{- classes.implode(' ') -}}"
    >
        <span>
            <span class="sr-only">
                {{- props.get('target') == '_self' ? 'Go to: ' : 'Go to external page: ' -}}
            </span>

            <span>
                {{- props.get('text') -}}
            </span>
        </span>

        {%- if props.get('icon') -%}
            {{- atoms.atom('svg', props.get('icon'), {
                utilities:  props.get('iconPosition') == 'after' ? 'ml-2' : 'mr-2', 
            }) -}}
        {%- endif -%}

    </a>


{%- endblock -%}