
{%- extends '_atoms/images/_image--props' -%}

{%- block image -%}

{%- set id = "content-#{random()}-#{props.get('image').id}" -%}
{%- set image = props.get('image') ??? null -%}

{% set myAssetQuery = craft.assets()
  .volume('contentgif') %}

  {% set imagesGif = myAssetQuery.all() %}

{% minify %}
{# {{ image.imageContentOptimized.pictureTag()
  .imgAttrs
    ({
      'sizes': props.get('sizes'),
      'alt': props.get('alt') ??? image.title ??? null,
      'class': "object-cover aspect-3/2 #{props.get('utilitiesImage')}",
      'fetchpriority': 'high'
    })
  .pictureAttrs
    ({
       'class': props.get('utilitiesPicture'),
    })
    .placeholder("#{props.get('placeholder')}")
  .loadingStrategy("#{props.get('loadingStrategy')}")
  .render()
}} #}

{% if image.extension == 'gif' %}
{# {% for imagegif in imagesGif %} #}
  <img
    src="{{ url(image.getUrl('')) }}"
    alt="{{ props.get('alt') ?? image.title }}"
    class="object-cover aspect-3/2 {{ props.get('utilitiesImage') }}"
    loading="{{ props.get('loadingStrategy')|default('lazy') }}"
    fetchpriority="high"
  >
  {# {% endfor %} #}
{% else %}
  {{ image.imageContentOptimized.pictureTag()
    .imgAttrs
      (props.get('attributes')|merge({
        'sizes': props.get('sizes'),
        'alt': props.get('alt') ?? image.title ?? null,
        'class': "inline-flex object-cover aspect-3/2 #{props.get('utilitiesImage')}",
        'fetchpriority': 'high'
      }))
    .pictureAttrs
      ({
         'class': props.get('utilitiesPicture'),
      })
      .placeholder("#{props.get('placeholder')}")
    .loadingStrategy("#{props.get('loadingStrategy')}")
    .render()
  }}
{% endif %}

{% endminify %}

{%- endblock -%}