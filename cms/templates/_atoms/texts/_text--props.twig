{#
    ### PROPERTIES ###
    ------------------
    alignment: (ENUM) -- the text alignment
    color: (ENUM) -- the color of the text
    content: (STR) -- the actual content as a string
    utilities: (STR) -- the specific TW spacing utilities to add
#}

{%- set props = collect({
    alignment: options.alignment ??? null,
    color: options.color ??? null,
    content: options.content ??? null,
    time: options.time ??? false,
    utilities: options.utilities ?? null,
}) -%}

{%- block text -%}
{%- endblock -%}




