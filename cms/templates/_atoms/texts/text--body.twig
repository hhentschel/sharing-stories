{%- extends '_atoms/texts/_text--props' -%}

{#
    ### PROPERTIES ###
    ------------------
    
    INHERITED FROM: `_atoms/texts/text--props.twig`
#}

{%- block text -%}
    {%- set props = props.merge ({
        type: options.type ??? 'large',
        typogrify: options.typogrify ?? true,
    }) -%}

    {%- set size = collect({
        'large': 'text-body-lg',
        'medium': 'text-base',
        'small': 'text-sm'
    }) -%}

    {%- set classes = collect({
        display: 'inline-flex items-center',
        color: props.get('color') ??? 'text-concrete-700',
        font: 'font-primary tracking-normal',
        type: size.get(props.get('type')),
        utilities: props.get('utilities'),
    }) -%}

    {%- minify -%}
        <span class="{{- classes.implode(' ') -}}">
            {{- props.get('typogrify') ? props.get('content')|typogrify(true) : props.get('content') -}}
        </span>
    {%- endminify -%}

{%- endblock -%}