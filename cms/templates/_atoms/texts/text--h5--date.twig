{%- extends '_atoms/texts/_text--props' -%}
{%- import '_macros/functions' as parse -%}

{#
    ### PROPERTIES ###
    ------------------
    
    INHERITED FROM: `_atoms/texts/text--props.twig`
#}

{%- block text -%}

    {%- set classes = collect({
        alignment: props.get('alignment'),
        color: props.get('color') ??? 'text-black',
        font: 'font-primary leading-snug font-bold tracking-wide',
        size: 'text-h5-sm md:text-h5-md lg:text-h5-lg',
        style: 'not-italic',
        utilities: props.get('utilities'),
    }) -%}

    {%- minify -%}
        <time datetime="{{- props.get('content')|date('c') -}}" class="{{ classes.implode(' ') }}">
            {{- parse.format_date(props.get('content')) -}}
        </time>
    {%- endminify -%}

{%- endblock -%}