{%- extends '_atoms/texts/_text--props' -%}

{#
    ### PROPERTIES ###
    ------------------
    
    INHERITED FROM: `_atoms/texts/text--props.twig`
#}

{%- block text -%}

    {%- set classes = collect({
        alignment: props.get('alignment'),
        color: props.get('color') ??? 'text-black',
        font: 'font-primary not-italic font-bold break-words',
        size: 'text-h5-sm md:text-h5-md lg:text-h5-lg',
        utilities: props.get('utilities'),
    }) -%}

    {%- minify -%}
        <span class="{{ classes.implode(' ') }}">
            {{- props.get('content')|typogrify(true)|raw -}}
        </span>
    {%- endminify -%}

{%- endblock -%}