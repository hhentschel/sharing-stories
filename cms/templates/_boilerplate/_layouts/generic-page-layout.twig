{# -- Layout template for HTML pages -- #}
{#
    ┌─────────────────────────────────────────────────────────────────────────────┐
    │ ┌─────────────────────────────────────────────────────────────────────────┐ │
    │ │                                                                         │ │
    │ │                                                                         │ │
    │ │                                                                         │ │
    │ │                                 content                                 │ │
    │ └─────────────────────────────────────────────────────────────────────────┘ │
    │                                                                             │
    │                                  bodyHtml                                   │
    └─────────────────────────────────────────────────────────────────────────────┘
#}
{% extends '_boilerplate/_layouts/base-html-layout.twig' %}

{# -- Any <meta> tags that should be included in the <head> #}
{% block headMeta %}
{% endblock headMeta %}

{# -- Any <link> tags that should be included in the <head> #}
{% block headLinks %}

{% endblock headLinks %}

{# -- Any CSS that should be included before </head> -- #}
{% block headCss %}
{% endblock headCss %}

{# -- Page body -- #}
{% block bodyHtml %}

{%- set navigation = craft.entries.section('pages')
        .cache()
        .level(1)
        .collect()
        .all()
    -%}

    <div id="page-wrapper">

        {# -- Header -- #}
        {%- include '_organisms/headers/header--primary' ignore missing -%}

        {# -- Navigation --  #}
       {# {%- include '_organisms/navigations/navigation--primary' ignore missing with {
            navigation: navigation,
        } -%} #}

        <main class="flex justify-between flex-col min-h-screen px-8" id="page-content" style="background-color: {{entry.pageBackgroundColor}};>

            {# -- Primary content block -- #}
            <div id="page" class="w-full grow flex flex-col relative" w-ref="page">
                {% block content %}

                {% endblock %}
                </div>

            {# -- Footer -- #}
            {%- include '_organisms/footers/footer--primary' ignore missing -%}
        </main>

        {# -- HTML Footer -- #}
        {% include '_boilerplate/_partials/global-footer.twig' %}
    </div>

{% endblock bodyHtml %}